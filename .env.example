# ═══════════════════════════════════════════════════════════════
# Research Aspirant — 환경변수 (독립 제품: 전용 Clerk 인스턴스 + 전용 Supabase 프로젝트)
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다.  Vercel: Settings → Environment Variables.
# NEXT_PUBLIC_ 로 시작하는 값만 브라우저에 공개된다. 나머지는 서버 전용(비밀, Sensitive 권장).
# 값 뒤에 주석을 붙이지 말 것 (Vercel 에 그대로 들어간다).
# ═══════════════════════════════════════════════════════════════

# ── Clerk (Research Aspirant 전용 애플리케이션) ──
# [공개] Clerk → API Keys 의 Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# [비밀] Clerk → API Keys 의 Secret key
CLERK_SECRET_KEY=sk_test_...
# [비밀] Clerk → Webhooks → Endpoint https://<도메인>/api/webhooks/clerk (user.created, user.deleted) 의 Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# ── Supabase (Research Aspirant 전용 프로젝트, supabase/schema.sql 을 1회 실행) ──
# [공개]
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [공개] publishable(anon) 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# [비밀] secret(service role) 키 — 서버 API 만 사용
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── 주소 ──
# [공개] 이 앱의 배포 주소
NEXT_PUBLIC_APP_URL=https://research-aspirant.vercel.app
# [공개] 랜딩이 같은 도메인의 첫 화면이므로 "/"
NEXT_PUBLIC_LANDING_URL=/
# [서버] API 를 호출해도 되는 출처 (앱 주소)
ALLOWED_ORIGINS=https://research-aspirant.vercel.app

# ── 관리자 ──
# [서버] 이 이메일로 가입·로그인하면 /control → /rdos/admin (가입 승인·회원·미션·메뉴 관리). 콤마로 여러 명.
SUPER_ADMIN_EMAILS=admin@example.com

# ── 선택: 연구 어시스턴트(음성/텍스트 질의응답) ──
# [비밀]
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-2.5-flash

# ── 선택: Microsoft Clarity ──
NEXT_PUBLIC_CLARITY_PROJECT_ID=
